{
  "name": "@taber/desktop",
  "productName": "HBA Guitar Taber",
  "desktopName": "hba-guitar-taber.desktop",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "description": "HBA Guitar Taber desktop app: the web editor, the API and the analysis worker in one window.",
  "author": "Ha Van Thien Bao",
  "homepage": "https://habaodunggithub.github.io/HBAGuitarTaber/",
  "repository": "github:habaodunggithub/HBAGuitarTaber",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stage": "node scripts/stage.mjs",
    "start": "pnpm build && electron .",
    "smoke": "pnpm build && node dist/smoke.js",
    "dist": "pnpm build && electron-builder --projectDir . --config electron-builder.yml --publish never"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "^5.6.0"
  }
}
